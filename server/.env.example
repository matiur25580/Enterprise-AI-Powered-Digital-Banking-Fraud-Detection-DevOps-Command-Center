MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/trustshield
# Generate a unique secret with at least 32 random characters; never reuse this example.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
PORT=5000
# Comma-separated exact frontend origins (include localhost during local development).
CLIENT_URL=https://your-vercel-url.vercel.app,http://localhost:5173
